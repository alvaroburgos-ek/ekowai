# Supabase (from `supabase status` after `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from supabase status>
SUPABASE_SERVICE_ROLE_KEY=<from supabase status — server-only, NEVER ship to client>

# Drizzle (server-only)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth bypass (TEST DEPLOYMENTS ONLY — never set in real production)
# When BYPASS_AUTH is set, middleware skips the login redirect and
# server-side auth.getUser() returns a stub user. BYPASS_AUTH_USER_ID
# must be a real UUID from auth.users that has an org_members row,
# otherwise the dashboard will be empty.
# BYPASS_AUTH=1
# BYPASS_AUTH_USER_ID=00000000-0000-0000-0000-000000000000

# Google OAuth (optional)
# Enable the "Sign in with Google" button on the login page.
# Requires Google OAuth credentials configured in the Supabase dashboard
# (Authentication → Providers → Google) and the callback URL
# https://<your-domain>/auth/callback whitelisted in Google Cloud Console.
# NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=1

# LLM mock mode (LOCAL DEV ONLY — never set in real production)
# When set, the /api/draft-rationale endpoint returns a fixed placeholder text
# instead of calling any AI provider. Lets you work on the UI without API keys.
# MOCK_LLM=1
