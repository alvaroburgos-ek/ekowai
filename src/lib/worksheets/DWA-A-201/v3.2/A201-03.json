{
  "contractVersion": "1.0",
  "regulation": "DWA-A-201",
  "regulationVersion": "v3.2",
  "id": "A201-03",
  "titleDe": "Nachklärung — Bemessung",
  "titleEn": "Secondary clarifier — sizing",
  "sourceCitation": "§A 7.3",
  "status": "preview",
  "inputs": [
    {
      "id": "Q_max_m3h",
      "type": "number",
      "labelDe": "Spitzenstundenzufluss Q_max",
      "labelEn": "Peak hourly flow Q_max",
      "unit": "m³/h",
      "citation": "§4.2.2",
      "min": 1,
      "max": 100000
    },
    {
      "id": "TS_BB_gL",
      "type": "number",
      "labelDe": "Trockensubstanz im Belebungsbecken TS_BB",
      "labelEn": "Mixed liquor suspended solids TS_BB",
      "unit": "g/L",
      "citation": "§A 7.3.2",
      "min": 1,
      "max": 8,
      "defaultValue": 4.0
    },
    {
      "id": "SVI_mLg",
      "type": "number",
      "labelDe": "Schlammindex ISV",
      "labelEn": "Sludge volume index SVI",
      "unit": "mL/g",
      "citation": "§A 7.3.4",
      "min": 50,
      "max": 250,
      "defaultValue": 120
    }
  ],
  "computed": [
    {
      "id": "VSV_mLL",
      "labelDe": "Vergleichsschlammvolumen VSV",
      "labelEn": "Comparison sludge volume VSV",
      "unit": "mL/L",
      "citation": "§A 7.3.5",
      "precision": 0,
      "expression": {
        "kind": "op",
        "op": "*",
        "lhs": { "kind": "ref", "id": "TS_BB_gL" },
        "rhs": { "kind": "ref", "id": "SVI_mLg" }
      }
    },
    {
      "id": "q_A_mh",
      "labelDe": "Maximale Schlammvolumenbeschickung q_A",
      "labelEn": "Max sludge volume loading q_A",
      "unit": "m/h",
      "citation": "§A 7.3.6",
      "precision": 2,
      "expression": {
        "kind": "op",
        "op": "/",
        "lhs": { "kind": "lit", "value": 600 },
        "rhs": { "kind": "ref", "id": "VSV_mLL" }
      }
    },
    {
      "id": "A_clarifier_m2",
      "labelDe": "Beckenoberfläche A",
      "labelEn": "Clarifier surface area A",
      "unit": "m²",
      "citation": "§A 7.3.7",
      "precision": 1,
      "expression": {
        "kind": "op",
        "op": "/",
        "lhs": { "kind": "ref", "id": "Q_max_m3h" },
        "rhs": { "kind": "ref", "id": "q_A_mh" }
      }
    }
  ],
  "thresholds": [
    {
      "id": "q_A_max",
      "ref": "q_A_mh",
      "rule": { "kind": "lte", "value": 1.6 },
      "severity": "blocking",
      "messageDe": "Schlammvolumenbeschickung übersteigt 1,6 m/h — Nachklärung nicht stabil betreibbar.",
      "messageEn": "Sludge volume loading exceeds 1.6 m/h — secondary clarifier not stably operable.",
      "citation": "§A 7.3.6"
    },
    {
      "id": "SVI_warn",
      "ref": "SVI_mLg",
      "rule": { "kind": "lte", "value": 150 },
      "severity": "warning",
      "messageDe": "ISV über 150 mL/g — Schlammeigenschaften prüfen, ggf. Blähschlammrisiko.",
      "messageEn": "SVI above 150 mL/g — check sludge properties, possible bulking sludge risk.",
      "citation": "§A 7.3.4"
    }
  ],
  "sections": [
    {
      "id": "inputs",
      "titleDe": "Eingangsdaten",
      "titleEn": "Inputs",
      "fields": ["Q_max_m3h", "TS_BB_gL", "SVI_mLg"]
    },
    {
      "id": "results",
      "titleDe": "Ergebnisse",
      "titleEn": "Results",
      "fields": ["VSV_mLL", "q_A_mh", "A_clarifier_m2"]
    }
  ],
  "decisionPoints": []
}
