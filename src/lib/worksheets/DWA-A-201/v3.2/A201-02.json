{
  "contractVersion": "1.0",
  "regulation": "DWA-A-201",
  "regulationVersion": "v3.2",
  "id": "A201-02",
  "titleDe": "Belüftung — Sauerstoffbedarf & Gebläseauslegung",
  "titleEn": "Aeration — oxygen demand & blower sizing",
  "sourceCitation": "§A 6.7",
  "status": "preview",
  "inputs": [
    {
      "id": "BSB5_load_kgd",
      "type": "number",
      "labelDe": "BSB₅-Fracht",
      "labelEn": "BOD₅ load",
      "unit": "kg/d",
      "citation": "§A 6.5.1",
      "min": 0,
      "max": 1000000
    },
    {
      "id": "f_C",
      "type": "number",
      "labelDe": "Faktor C-Atmung f_C",
      "labelEn": "Endogenous respiration factor f_C",
      "unit": "—",
      "citation": "§A 6.7.2",
      "min": 0.8,
      "max": 1.5,
      "defaultValue": 1.2
    },
    {
      "id": "alpha_O2",
      "type": "number",
      "labelDe": "α-Wert (Sauerstoffeintrag)",
      "labelEn": "α value (oxygen transfer)",
      "unit": "—",
      "citation": "§A 6.7.5",
      "min": 0.4,
      "max": 1.0,
      "defaultValue": 0.7
    },
    {
      "id": "C_sat_O2_mgL",
      "type": "number",
      "labelDe": "Sättigungskonzentration O₂",
      "labelEn": "O₂ saturation concentration",
      "unit": "mg/L",
      "citation": "§A 6.7.4",
      "min": 6,
      "max": 12,
      "defaultValue": 9.0
    }
  ],
  "computed": [
    {
      "id": "O2_demand_kgd",
      "labelDe": "Sauerstoffbedarf OV",
      "labelEn": "Oxygen demand OV",
      "unit": "kg O₂/d",
      "citation": "§A 6.7.1",
      "precision": 1,
      "expression": {
        "kind": "op",
        "op": "*",
        "lhs": { "kind": "ref", "id": "BSB5_load_kgd" },
        "rhs": { "kind": "ref", "id": "f_C" }
      }
    },
    {
      "id": "O2_required_kgh",
      "labelDe": "Stündlicher Sauerstoffbedarf",
      "labelEn": "Hourly oxygen demand",
      "unit": "kg O₂/h",
      "citation": "§A 6.7.3",
      "precision": 2,
      "expression": {
        "kind": "op",
        "op": "/",
        "lhs": { "kind": "ref", "id": "O2_demand_kgd" },
        "rhs": { "kind": "lit", "value": 24 }
      }
    },
    {
      "id": "blower_capacity_m3h",
      "labelDe": "Mindest-Gebläseleistung",
      "labelEn": "Minimum blower capacity",
      "unit": "m³/h",
      "citation": "§A 6.7.6",
      "precision": 0,
      "expression": {
        "kind": "fn",
        "fn": "ceil",
        "args": [
          {
            "kind": "op",
            "op": "/",
            "lhs": {
              "kind": "op",
              "op": "*",
              "lhs": { "kind": "ref", "id": "O2_required_kgh" },
              "rhs": { "kind": "lit", "value": 1000 }
            },
            "rhs": {
              "kind": "op",
              "op": "*",
              "lhs": { "kind": "ref", "id": "alpha_O2" },
              "rhs": {
                "kind": "op",
                "op": "*",
                "lhs": { "kind": "ref", "id": "C_sat_O2_mgL" },
                "rhs": { "kind": "lit", "value": 0.21 }
              }
            }
          }
        ]
      }
    }
  ],
  "thresholds": [
    {
      "id": "alpha_warn",
      "ref": "alpha_O2",
      "rule": { "kind": "gte", "value": 0.5 },
      "severity": "warning",
      "messageDe": "α-Wert sehr niedrig — Sauerstoffeintrag möglicherweise unzureichend.",
      "messageEn": "α value very low — oxygen transfer may be insufficient.",
      "citation": "§A 6.7.5"
    }
  ],
  "sections": [
    {
      "id": "inputs",
      "titleDe": "Eingangsdaten",
      "titleEn": "Inputs",
      "fields": ["BSB5_load_kgd", "f_C", "alpha_O2", "C_sat_O2_mgL"]
    },
    {
      "id": "results",
      "titleDe": "Ergebnisse",
      "titleEn": "Results",
      "fields": ["O2_demand_kgd", "O2_required_kgh", "blower_capacity_m3h"]
    }
  ],
  "decisionPoints": [
    {
      "id": "A201-02-DP1",
      "labelDe": "Belüftungssystem",
      "labelEn": "Aeration system",
      "promptDe": "Welches Belüftungssystem ist für diese Anlage vorgesehen?",
      "promptEn": "Which aeration system is planned for this plant?",
      "citation": "§A 6.7.8",
      "options": [
        { "value": "fine_bubble", "labelDe": "Feinblasige Druckluftbelüftung", "labelEn": "Fine-bubble diffused aeration" },
        { "value": "coarse_bubble", "labelDe": "Grobblasige Belüftung", "labelEn": "Coarse-bubble aeration" },
        { "value": "surface", "labelDe": "Oberflächenbelüftung (Walzen / Kreisel)", "labelEn": "Surface aeration (rotors / brushes)" }
      ]
    }
  ]
}
