{
  "contractVersion": "1.0",
  "regulation": "DWA-A-201",
  "regulationVersion": "v3.2",
  "id": "A201-12",
  "titleDe": "Bemessungsbericht — Zusammenfassung",
  "titleEn": "Sizing summary — final report",
  "sourceCitation": "§A 11",
  "status": "preview",
  "inputs": [
    {
      "id": "PE_total",
      "type": "number",
      "labelDe": "Einwohnergleichwerte PE",
      "labelEn": "Population equivalents PE",
      "unit": "EW",
      "citation": "§3.2",
      "min": 50,
      "max": 5000000
    },
    {
      "id": "Q_DW_m3d",
      "type": "number",
      "labelDe": "Schmutzwasserzufluss Q_DW",
      "labelEn": "Dry-weather flow Q_DW",
      "unit": "m³/d",
      "citation": "§4.2.1",
      "min": 1,
      "max": 1000000
    },
    {
      "id": "BSB5_in_mgL",
      "type": "number",
      "labelDe": "BSB₅ Zulauf",
      "labelEn": "BOD₅ inlet",
      "unit": "mg/L",
      "citation": "§4.3",
      "min": 0,
      "max": 10000
    },
    {
      "id": "treatment_class",
      "type": "select",
      "labelDe": "Reinigungsklasse",
      "labelEn": "Treatment class",
      "citation": "§3.1",
      "options": [
        { "value": "C", "labelDe": "Klasse C (Kohlenstoff)", "labelEn": "Class C (carbon)" },
        { "value": "N", "labelDe": "Klasse N (Nitrifikation)", "labelEn": "Class N (nitrification)" },
        { "value": "DN", "labelDe": "Klasse D (Denitrifikation)", "labelEn": "Class D (denitrification)" },
        { "value": "PN", "labelDe": "Klasse P+N (P-Elimination)", "labelEn": "Class P+N (P elimination)" }
      ],
      "defaultValue": "DN"
    }
  ],
  "computed": [
    {
      "id": "BSB5_load_kgd",
      "labelDe": "BSB₅-Fracht (gesamt)",
      "labelEn": "BOD₅ load (total)",
      "unit": "kg/d",
      "citation": "§A 6.5.1",
      "precision": 1,
      "expression": {
        "kind": "op",
        "op": "/",
        "lhs": {
          "kind": "op",
          "op": "*",
          "lhs": { "kind": "ref", "id": "Q_DW_m3d" },
          "rhs": { "kind": "ref", "id": "BSB5_in_mgL" }
        },
        "rhs": { "kind": "lit", "value": 1000 }
      }
    },
    {
      "id": "load_per_PE_gd",
      "labelDe": "BSB₅-Fracht je EW",
      "labelEn": "BOD₅ load per PE",
      "unit": "g/(EW·d)",
      "citation": "§3.2",
      "precision": 0,
      "expression": {
        "kind": "op",
        "op": "/",
        "lhs": {
          "kind": "op",
          "op": "*",
          "lhs": { "kind": "ref", "id": "BSB5_load_kgd" },
          "rhs": { "kind": "lit", "value": 1000 }
        },
        "rhs": { "kind": "ref", "id": "PE_total" }
      }
    },
    {
      "id": "Q_per_PE_Ld",
      "labelDe": "Schmutzwasseranfall je EW",
      "labelEn": "Dry-weather flow per PE",
      "unit": "L/(EW·d)",
      "citation": "§4.2.1",
      "precision": 0,
      "expression": {
        "kind": "op",
        "op": "/",
        "lhs": {
          "kind": "op",
          "op": "*",
          "lhs": { "kind": "ref", "id": "Q_DW_m3d" },
          "rhs": { "kind": "lit", "value": 1000 }
        },
        "rhs": { "kind": "ref", "id": "PE_total" }
      }
    }
  ],
  "thresholds": [
    {
      "id": "load_per_PE_warn_low",
      "ref": "load_per_PE_gd",
      "rule": { "kind": "gte", "value": 40 },
      "severity": "warning",
      "messageDe": "BSB₅-Fracht je EW unter 40 g/(EW·d) — Plausibilität der Eingangsfracht prüfen.",
      "messageEn": "BOD₅ load per PE below 40 g/(PE·d) — check plausibility of inlet load.",
      "citation": "§3.2"
    },
    {
      "id": "load_per_PE_warn_high",
      "ref": "load_per_PE_gd",
      "rule": { "kind": "lte", "value": 90 },
      "severity": "warning",
      "messageDe": "BSB₅-Fracht je EW über 90 g/(EW·d) — Industrieanteil prüfen.",
      "messageEn": "BOD₅ load per PE above 90 g/(PE·d) — check industrial share.",
      "citation": "§3.2"
    },
    {
      "id": "Q_per_PE_warn",
      "ref": "Q_per_PE_Ld",
      "rule": { "kind": "lte", "value": 250 },
      "severity": "warning",
      "messageDe": "Spez. Schmutzwasseranfall über 250 L/(EW·d) — Fremdwasseranteil prüfen.",
      "messageEn": "Specific dry-weather flow above 250 L/(PE·d) — check infiltration share.",
      "citation": "§4.2.1"
    }
  ],
  "sections": [
    {
      "id": "inputs",
      "titleDe": "Bemessungsgrundlagen",
      "titleEn": "Design basis",
      "fields": ["PE_total", "Q_DW_m3d", "BSB5_in_mgL", "treatment_class"]
    },
    {
      "id": "results",
      "titleDe": "Kennzahlen",
      "titleEn": "Key metrics",
      "fields": ["BSB5_load_kgd", "load_per_PE_gd", "Q_per_PE_Ld"]
    }
  ],
  "decisionPoints": [
    {
      "id": "A201-12-DP1",
      "labelDe": "Anlagenkategorie",
      "labelEn": "Plant size category",
      "promptDe": "In welche Größenklasse nach DWA-A-198 fällt die Anlage?",
      "promptEn": "Which size category per DWA-A-198 does the plant fall into?",
      "citation": "DWA-A-198 §3",
      "options": [
        { "value": "GK1", "labelDe": "GK 1 (< 1 000 EW)", "labelEn": "Size class 1 (< 1,000 PE)" },
        { "value": "GK2", "labelDe": "GK 2 (1 000 – 5 000 EW)", "labelEn": "Size class 2 (1,000 – 5,000 PE)" },
        { "value": "GK3", "labelDe": "GK 3 (5 000 – 10 000 EW)", "labelEn": "Size class 3 (5,000 – 10,000 PE)" },
        { "value": "GK4", "labelDe": "GK 4 (10 000 – 100 000 EW)", "labelEn": "Size class 4 (10,000 – 100,000 PE)" },
        { "value": "GK5", "labelDe": "GK 5 (> 100 000 EW)", "labelEn": "Size class 5 (> 100,000 PE)" }
      ]
    }
  ]
}
