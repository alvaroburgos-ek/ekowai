{
  "contractVersion": "1.0",
  "regulation": "DWA-A-201",
  "regulationVersion": "v3.2",
  "id": "A201-08",
  "titleDe": "Bemessung Belebungsbecken — Variante 1",
  "titleEn": "Aeration tank sizing — variant 1",
  "sourceCitation": "§A 6.5",
  "inputs": [
    {
      "id": "Q_DW_m3d",
      "type": "number",
      "labelDe": "Schmutzwasserzufluss Q_DW",
      "labelEn": "Dry-weather flow Q_DW",
      "unit": "m³/d",
      "citation": "§4.2.1",
      "min": 1,
      "max": 1000000
    },
    {
      "id": "BSB5_in_mgL",
      "type": "number",
      "labelDe": "BSB₅ Zulauf",
      "labelEn": "BOD₅ inlet",
      "unit": "mg/L",
      "citation": "§4.3",
      "min": 0,
      "max": 10000
    },
    {
      "id": "T_C",
      "type": "number",
      "labelDe": "Temperatur",
      "labelEn": "Temperature",
      "unit": "°C",
      "citation": "§4.4",
      "min": 0,
      "max": 30,
      "defaultValue": 12
    },
    {
      "id": "treatment_class",
      "type": "select",
      "labelDe": "Reinigungsklasse",
      "labelEn": "Treatment class",
      "citation": "§3.1",
      "options": [
        { "value": "C", "labelDe": "Klasse C (Kohlenstoff)", "labelEn": "Class C (carbon)" },
        { "value": "N", "labelDe": "Klasse N (Nitrifikation)", "labelEn": "Class N (nitrification)" },
        { "value": "DN", "labelDe": "Klasse D (Denitrifikation)", "labelEn": "Class D (denitrification)" }
      ],
      "defaultValue": "N"
    }
  ],
  "computed": [
    {
      "id": "BSB5_load_kgd",
      "labelDe": "BSB₅-Fracht",
      "labelEn": "BOD₅ load",
      "unit": "kg/d",
      "citation": "§A 6.5.1",
      "precision": 1,
      "expression": {
        "kind": "op",
        "op": "/",
        "lhs": {
          "kind": "op",
          "op": "*",
          "lhs": { "kind": "ref", "id": "Q_DW_m3d" },
          "rhs": { "kind": "ref", "id": "BSB5_in_mgL" }
        },
        "rhs": { "kind": "lit", "value": 1000 }
      }
    },
    {
      "id": "tank_volume_m3",
      "labelDe": "Beckenvolumen",
      "labelEn": "Tank volume",
      "unit": "m³",
      "citation": "§A 6.5.4",
      "precision": 0,
      "expression": {
        "kind": "fn",
        "fn": "ceil",
        "args": [
          {
            "kind": "op",
            "op": "*",
            "lhs": { "kind": "ref", "id": "BSB5_load_kgd" },
            "rhs": { "kind": "lit", "value": 4.0 }
          }
        ]
      }
    },
    {
      "id": "BSB5_outlet_mgL",
      "labelDe": "BSB₅-Ablauf (Schätzung)",
      "labelEn": "BOD₅ outlet (estimated)",
      "unit": "mg/L",
      "citation": "§A 6.5.7",
      "precision": 1,
      "expression": {
        "kind": "cond",
        "if": {
          "kind": "cmp",
          "op": "==",
          "lhs": { "kind": "ref", "id": "treatment_class" },
          "rhs": { "kind": "lit", "value": 0 }
        },
        "then": { "kind": "lit", "value": 25 },
        "else": { "kind": "lit", "value": 15 }
      }
    }
  ],
  "thresholds": [
    {
      "id": "BSB5_outlet_max",
      "ref": "BSB5_outlet_mgL",
      "rule": { "kind": "lte", "value": 25 },
      "severity": "blocking",
      "messageDe": "BSB₅-Ablauf überschreitet 25 mg/L (DWA-A-201 Mindestanforderung).",
      "messageEn": "BOD₅ outlet exceeds 25 mg/L (DWA-A-201 minimum requirement).",
      "citation": "§3.1"
    },
    {
      "id": "tank_volume_warn",
      "ref": "tank_volume_m3",
      "rule": { "kind": "lte", "value": 50000 },
      "severity": "warning",
      "messageDe": "Beckenvolumen ist sehr groß — bitte Plausibilität prüfen.",
      "messageEn": "Tank volume is unusually large — please double-check inputs.",
      "citation": "§A 6.5.4"
    }
  ],
  "sections": [
    {
      "id": "inputs",
      "titleDe": "Eingangsdaten",
      "titleEn": "Inputs",
      "fields": ["Q_DW_m3d", "BSB5_in_mgL", "T_C", "treatment_class"]
    },
    {
      "id": "results",
      "titleDe": "Ergebnisse",
      "titleEn": "Results",
      "fields": ["BSB5_load_kgd", "tank_volume_m3", "BSB5_outlet_mgL"]
    }
  ]
}
