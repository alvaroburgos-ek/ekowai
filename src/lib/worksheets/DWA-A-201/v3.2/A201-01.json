{
  "contractVersion": "1.0",
  "regulation": "DWA-A-201",
  "regulationVersion": "v3.2",
  "id": "A201-01",
  "titleDe": "Vorklärung — Bemessung",
  "titleEn": "Primary clarifier — sizing",
  "sourceCitation": "§A 5.2",
  "status": "preview",
  "inputs": [
    {
      "id": "Q_max_m3h",
      "type": "number",
      "labelDe": "Spitzenstundenzufluss Q_max",
      "labelEn": "Peak hourly flow Q_max",
      "unit": "m³/h",
      "citation": "§4.2.2",
      "min": 1,
      "max": 100000
    },
    {
      "id": "alpha_O",
      "type": "number",
      "labelDe": "Oberflächenbeschickung α",
      "labelEn": "Overflow rate α",
      "unit": "m/h",
      "citation": "§A 5.2.3",
      "min": 0.5,
      "max": 4,
      "defaultValue": 1.5
    },
    {
      "id": "h_min_m",
      "type": "number",
      "labelDe": "Mindestwassertiefe h_min",
      "labelEn": "Minimum water depth h_min",
      "unit": "m",
      "citation": "§A 5.2.5",
      "min": 1.5,
      "max": 6,
      "defaultValue": 2.0
    }
  ],
  "computed": [
    {
      "id": "A_clarifier_m2",
      "labelDe": "Beckenoberfläche A",
      "labelEn": "Clarifier surface area A",
      "unit": "m²",
      "citation": "§A 5.2.4",
      "precision": 1,
      "expression": {
        "kind": "op",
        "op": "/",
        "lhs": { "kind": "ref", "id": "Q_max_m3h" },
        "rhs": { "kind": "ref", "id": "alpha_O" }
      }
    },
    {
      "id": "V_clarifier_m3",
      "labelDe": "Beckenvolumen V",
      "labelEn": "Clarifier volume V",
      "unit": "m³",
      "citation": "§A 5.2.6",
      "precision": 0,
      "expression": {
        "kind": "op",
        "op": "*",
        "lhs": { "kind": "ref", "id": "A_clarifier_m2" },
        "rhs": { "kind": "ref", "id": "h_min_m" }
      }
    },
    {
      "id": "retention_h",
      "labelDe": "Aufenthaltszeit τ",
      "labelEn": "Retention time τ",
      "unit": "h",
      "citation": "§A 5.2.7",
      "precision": 2,
      "expression": {
        "kind": "op",
        "op": "/",
        "lhs": { "kind": "ref", "id": "V_clarifier_m3" },
        "rhs": { "kind": "ref", "id": "Q_max_m3h" }
      }
    }
  ],
  "thresholds": [
    {
      "id": "retention_min",
      "ref": "retention_h",
      "rule": { "kind": "gte", "value": 1.0 },
      "severity": "blocking",
      "messageDe": "Aufenthaltszeit unter 1,0 h — Vorklärung nicht ausreichend wirksam.",
      "messageEn": "Retention time below 1.0 h — primary clarifier insufficiently effective.",
      "citation": "§A 5.2.7"
    },
    {
      "id": "retention_warn",
      "ref": "retention_h",
      "rule": { "kind": "gte", "value": 1.5 },
      "severity": "warning",
      "messageDe": "Aufenthaltszeit unter 1,5 h — Plausibilität prüfen.",
      "messageEn": "Retention time below 1.5 h — please double-check.",
      "citation": "§A 5.2.7"
    }
  ],
  "sections": [
    {
      "id": "inputs",
      "titleDe": "Eingangsdaten",
      "titleEn": "Inputs",
      "fields": ["Q_max_m3h", "alpha_O", "h_min_m"]
    },
    {
      "id": "results",
      "titleDe": "Ergebnisse",
      "titleEn": "Results",
      "fields": ["A_clarifier_m2", "V_clarifier_m3", "retention_h"]
    }
  ],
  "decisionPoints": []
}
